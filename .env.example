# Local development only. The compose file publishes the same credentials.
SOC_DATABASE_URL=postgresql+psycopg://soc:soc@localhost:5434/soc
SOC_REDIS_URL=redis://localhost:6379/0
SOC_OUTBOX_STREAM=soc.outbox
SOC_OUTBOX_BATCH_SIZE=100
SOC_OUTBOX_MAX_ATTEMPTS=5
SOC_OUTBOX_POLL_INTERVAL_SECONDS=1
SOC_MAX_PAYLOAD_BYTES=8388608
SOC_API_CURSOR_SECRET=dev-only-change-me
